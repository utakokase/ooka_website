{
  "redirects": [
    { "source": "/about-us", "destination": "/company", "permanent": true },
    { "source": "/primeparksshinagawa", "destination": "/properties/prime-parks-shinagawa", "permanent": true },
    { "source": "/nakano", "destination": "/tsuchiya-building", "permanent": true },
    { "source": "/properties/tsuchiya-building", "destination": "/tsuchiya-building", "permanent": true },
    { "source": "/adachi", "destination": "/properties/adachi-house", "permanent": true },
    { "source": "/iruma", "destination": "/properties/iruma-apartment", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
